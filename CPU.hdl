
CHIP CPU {
    IN inM[16], instruction[16], reset;
    OUT outM[16], writeM, addressM[15], pc[15];

    PARTS:
    Mux16(a=instruction, b=inM,
        sel=instruction[15], out=aOrM);

    Not(in=instruction[15], out=isA);

    Or(a=isA, b=instruction[5], out=loadA);

    ARegister(in=aOrM, load=loadA,
        out=aOut, out[0..14]=addressM);

    And(a=instruction[15], b=instruction[12],
        out=useM);

    Mux16(a=aOut, b=inM,
        sel=useM, out=aluY);

    DRegister(in=aluOut, load=loadD, out=dOut);

    ALU(x=dOut, y=aluY,
        zx=instruction[11],
        nx=instruction[10],
        zy=instruction[9],
        ny=instruction[8],
        f=instruction[7],
        no=instruction[6],
        out=aluOut, out=outM,
        zr=zr, ng=ng);

    And(a=instruction[15], b=instruction[3],
        out=writeM);

    And(a=instruction[15], b=instruction[4],
        out=loadD);

    And(a=instruction[15], b=instruction[5],
        out=loadA);

    // Jump condition logic
    Not(in=ng, out=positive);
    Not(in=zr, out=notZero);

    And(a=instruction[2], b=ng, out=jlt);
    And(a=instruction[1], b=zr, out=jeq);
    And(a=instruction[0], b=positive, out=jgt);

    Or(a=jlt, b=jeq, out=j1);
    Or(a=j1, b=jgt, out=jump);

    And(a=instruction[15], b=jump, out=doJump);

    PC(in=aOut, load=doJump,
        inc=true, reset=reset, out[0..14]=pc);
}
